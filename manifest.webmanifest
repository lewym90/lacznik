{
  "name": "Łącznik",
  "short_name": "Łącznik",
  "description": "Pliki, zdjęcia, notatki, linki i kody — od razu na każdym Twoim urządzeniu.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "lang": "pl",
  "background_color": "#F2F3F8",
  "theme_color": "#F2F3F8",
  "icons": [
    { "src": "ikony/ikona-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "ikony/ikona-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "ikony/ikona-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./udostepnij",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "pliki", "accept": ["*/*", "image/*", "video/*", "application/pdf", "text/*"] }]
    }
  }
}
